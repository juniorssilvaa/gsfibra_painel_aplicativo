# Backend Dockerfile - NioChat
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV DEBIAN_FRONTEND=noninteractive

# Install system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    libpq-dev \
    ffmpeg \
    curl \
    postgresql-client \
    netcat-openbsd \
    cron \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy requirements
COPY painel-provedor/backend/requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Copy project files
COPY . .

# Go to backend directory
WORKDIR /app/painel-provedor/backend

# Tornar scripts executáveis (para cron)
RUN chmod +x scripts/finalize_closing_cron.py || true

# ============================================
# Espera PostgreSQL (timeout, pg_isready, parsing seguro de DATABASE_URL)
# ============================================
COPY painel-provedor/wait-for-postgres.sh /app/wait-for-postgres.sh
RUN chmod +x /app/wait-for-postgres.sh
COPY painel-provedor/wait-for-redis.sh /app/wait-for-redis.sh
RUN chmod +x /app/wait-for-redis.sh

# ============================================
# ENTRYPOINT - copiado como arquivo separado
# ============================================
COPY painel-provedor/entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh


# ============================================
# Create CRON entrypoint script
# ============================================
RUN cat << 'EOF' > /app/cron-entrypoint.sh
#!/bin/bash
set -e

echo "Starting NioChat Cron Service..."

if [[ -x /app/wait-for-postgres.sh ]]; then
  /app/wait-for-postgres.sh
fi

# Criar diretório de logs
mkdir -p /var/log/niochat

# Configurar cron
echo "Configurando cron..."
echo '*/2 * * * * cd /app/painel-provedor/backend && python scripts/finalize_closing_cron.py >> /var/log/niochat/finalize_closing.log 2>&1' | crontab -

echo "✅ Cron configurado. Executando a cada 2 minutos."
echo "📋 Logs disponíveis em: /var/log/niochat/finalize_closing.log"

# Iniciar cron em foreground
exec cron -f
EOF

RUN chmod +x /app/cron-entrypoint.sh

# Expose port
EXPOSE 8010

# Healthcheck
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD curl -f -L http://localhost:8010/api/health/ || exit 1

# Use entrypoint
ENTRYPOINT ["/app/entrypoint.sh"]

# Default command → Daphne WebSocket/HTTP
CMD ["daphne", "-b", "0.0.0.0", "-p", "8010", "niochat.asgi:application"]

# Copie para .env (ou adicione estas linhas) para desenvolvimento local no Windows.

# Sem isto o webhook Meta (/api/webhook/whatsapp-cloud/) devolve 403
# (assinatura inválida) e mensagens WhatsApp não entram no chat.
DEBUG=True
# App Secret do Facebook/Meta App (preferível). Com DEBUG/LOCAL_DEV dá para
# receber mensagens mesmo sem secret — mas use o valor real se tiver.
# FACEBOOK_APP_SECRET=

# WebSocket/API sem depender do Redis da VPS
LOCAL_DEV=1
CHANNEL_LAYER_BACKEND=inmemory

# Redis local (opcional se não usar LOCAL_DEV)
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=

# Integração com superadmin local (porta 8010)
SUPERADMIN_API_URL=http://127.0.0.1:8010
# Id central no superadmin (pode diferir do id local no tenant, ex.: central 10 → local 6)
SUPERADMIN_PROVEDOR_ID=10
# Mesmo valor de ADMIN_WEBHOOK_SECRET no SystemConfig do superadmin
ADMIN_WEBHOOK_SECRET=coloque_o_secret_do_superadmin_aqui
# Opcional: token do provedor (Superadmin → Provedor → Rotacionar token de integração)
# SUPERADMIN_PROVIDER_TOKEN=

# Instagram Business Login (credenciais DIFERENTES do Facebook App ID do WhatsApp)
# Meta App Dashboard → Instagram → API setup with Instagram login → Business login settings
# INSTAGRAM_APP_ID=
# INSTAGRAM_APP_SECRET=
# Redirect URI local na Meta (Instagram Business Login):
# https://api-local.niohub.com.br/api/auth/instagram/callback/
# BACKEND_URL=https://api-local.niohub.com.br

# Estúdio de Marketing — análise de Instagram de concorrentes (Business Discovery)
# ID da conta Instagram profissional da NioHub ligada a uma Página do Facebook e token de usuário do
# sistema (Gerenciador de Negócios) com instagram_basic, pages_show_list e business_management.
# Sem o token, usa WHATSAPP_SYSTEM_USER_TOKEN.
# META_DISCOVERY_IG_USER_ID=
# META_DISCOVERY_ACCESS_TOKEN=

# NioHub Calls — ligações por QR (Go nativo, sem Docker no serviço)
# Requer PostgreSQL local + NioHub Telefonia:
#   .\tools\niohub-telefonia\start-niohub-telefonia.ps1
# Docs: services/niohub-telefonia/README.md
NIOHUB_CALLS_BASE_URL=http://127.0.0.1:8080
NIOHUB_CALLS_API_KEY=
# Produção (Docker Swarm): injetado pelo Portainer — URL interna do backend p/ webhooks do Go
# NIOHUB_CALLS_WEBHOOK_SELF_URL=http://niohub-{slug}_niochat-backend:8010

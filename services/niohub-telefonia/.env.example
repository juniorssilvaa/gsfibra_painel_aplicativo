# Copie para .env e ajuste a senha do Postgres local.
# Uso: .\tools\niohub-telefonia\start-niohub-telefonia.ps1

WACALLS_PG_URL=postgres://postgres:SUA_SENHA_AQUI@127.0.0.1:5432/postgres?sslmode=disable
WACALLS_PG_NAMESPACE=niohub_calls

# Opcional (produção / NAT). Em localhost costuma não ser necessário.
# WACALLS_PUBLIC_IP=auto
# WACALLS_UDP_PORT=3478

# Porta HTTP do serviço (padrão 8080)
# NIOHUB_CALLS_PORT=8080

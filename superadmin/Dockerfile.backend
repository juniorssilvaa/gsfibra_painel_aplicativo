# Superadmin Backend Dockerfile - NioHub
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV DEBIAN_FRONTEND=noninteractive

# Install system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    libpq-dev \
    ffmpeg \
    curl \
    postgresql-client \
    netcat-openbsd \
    cron \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy requirements
COPY superadmin/backend/requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Copy project files
COPY . .

# Go to backend directory
WORKDIR /app/superadmin/backend

# Tornar scripts executáveis (para cron)
RUN chmod +x scripts/finalize_closing_cron.py || true
RUN chmod +x scripts/billing_auto_block_cron.py || true

# ============================================
# Create ENTRYPOINT script (GitHub Actions safe)
# ============================================
RUN cat << 'EOF' > /app/entrypoint.sh
#!/bin/bash
set -e

echo "Starting NioChat Backend..."

# Extrair host e porta para o teste de conexão
if [ -n "$POSTGRES_HOST" ]; then
    DB_HOST="$POSTGRES_HOST"
    DB_PORT="${POSTGRES_PORT:-5432}"
elif [ -n "$DATABASE_URL" ]; then
    DB_HOST=$(echo $DATABASE_URL | sed -e 's|.*@||' -e 's|/.*||' -e 's|:.*||')
    DB_PORT=$(echo $DATABASE_URL | sed -e 's|.*:||' -e 's|/.*||')
    [[ ! "$DB_PORT" =~ ^[0-9]+$ ]] && DB_PORT=5432
else
    DB_HOST="postgres"
    DB_PORT=5432
fi

echo "⏳ Waiting for PostgreSQL at $DB_HOST:$DB_PORT..."

until nc -z -v -w3 "$DB_HOST" "$DB_PORT"; do
  echo "⏳ PostgreSQL ainda não disponível... aguardando 1s"
  sleep 1
done

echo "✅ PostgreSQL disponível!"

echo "Running migrations..."
echo "Running migrations..."
# Auto-fix para banco corrompido pela falta do __init__.py em execuções anteriores
python -c "
import os, django
os.environ.setdefault('DJANGO_SETTINGS_MODULE', 'niochat_sa.settings')
django.setup()
from django.db import connection

with connection.cursor() as cursor:
    cursor.execute(\"SELECT EXISTS (SELECT FROM information_schema.tables WHERE table_name = 'django_migrations')\")
    has_migrations = cursor.fetchone()[0]
    cursor.execute(\"SELECT EXISTS (SELECT FROM information_schema.tables WHERE table_name = 'super_core_user')\")
    has_users = cursor.fetchone()[0]

    if has_migrations and not has_users:
        print('[FIX] Banco corrompido detectado (migrations aplicadas sem super_core). Limpando schema public...')
        cursor.execute('DROP SCHEMA public CASCADE; CREATE SCHEMA public; GRANT ALL ON SCHEMA public TO public;')
        print('[FIX] Schema recriado com sucesso.')
"

python manage.py migrate --noinput

echo "Collecting static files..."
python manage.py collectstatic --noinput

echo "Launching Daphne server..."
exec "$@"
EOF

RUN chmod +x /app/entrypoint.sh

# ============================================
# Create CRON entrypoint script
# ============================================
RUN cat << 'EOF' > /app/cron-entrypoint.sh
#!/bin/bash
set -e

echo "Starting NioChat Cron Service..."

if [ -n "$POSTGRES_HOST" ]; then
    DB_HOST="$POSTGRES_HOST"
    DB_PORT="${POSTGRES_PORT:-5432}"
elif [ -n "$DATABASE_URL" ]; then
    DB_HOST=$(echo $DATABASE_URL | sed -e 's|.*@||' -e 's|/.*||' -e 's|:.*||')
    DB_PORT=$(echo $DATABASE_URL | sed -e 's|.*:||' -e 's|/.*||')
    [[ ! "$DB_PORT" =~ ^[0-9]+$ ]] && DB_PORT=5432
else
    DB_HOST="postgres"
    DB_PORT=5432
fi

echo "⏳ Waiting for PostgreSQL at $DB_HOST:$DB_PORT..."

until nc -z -v -w3 "$DB_HOST" "$DB_PORT"; do
  echo "⏳ PostgreSQL ainda não disponível... aguardando 1s"
  sleep 1
done

echo "✅ PostgreSQL disponível!"

# Criar diretório de logs
mkdir -p /var/log/niochat

# Configurar cron
echo "Configurando cron..."
(
  echo '*/2 * * * * cd /app/superadmin/backend && python scripts/finalize_closing_cron.py >> /var/log/niochat/finalize_closing.log 2>&1'
  echo '*/10 * * * * cd /app/superadmin/backend && python scripts/billing_auto_block_cron.py >> /var/log/niochat/billing_auto_block.log 2>&1'
) | crontab -

echo "✅ Cron configurado."
echo "📋 Logs: /var/log/niochat/finalize_closing.log e /var/log/niochat/billing_auto_block.log"

# Iniciar cron em foreground
exec cron -f
EOF

RUN chmod +x /app/cron-entrypoint.sh

# Expose port
EXPOSE 8010

# Healthcheck
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD curl -f -L http://localhost:8010/api/health/ || exit 1

# Use entrypoint
ENTRYPOINT ["/app/entrypoint.sh"]

# Default command → Daphne WebSocket/HTTP
CMD ["daphne", "-b", "0.0.0.0", "-p", "8010", "niochat_sa.asgi:application"]

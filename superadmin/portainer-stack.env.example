# Copie para o Portainer: "Load variables from .env file" na stack do Superadmin,
# ou adicione manualmente cada variável em Environment.
#
# === PostgreSQL (obrigatório no deploy: sem POSTGRES_PASSWORD a stack não sobe) ===
# Use os mesmos valores no pgAdmin. O docker-compose exige POSTGRES_PASSWORD definido.
POSTGRES_DB=niohub_superadmin
POSTGRES_USER=niohub
POSTGRES_PASSWORD=troque_esta_senha_por_uma_forte
#
# Opcional: o Django usa DATABASE_URL se existir (tem prioridade sobre POSTGRES_*).
# Ajuste usuário, senha e nome do banco para bater com os valores acima.
# DATABASE_URL=postgresql://niohub:troque_esta_senha_por_uma_forte@superadmin-postgres:5432/niohub_superadmin
#
# Host/porta dentro da rede Docker (não mude salvo se renomear o serviço no compose)
POSTGRES_HOST=superadmin-postgres
POSTGRES_PORT=5432

REDIS_PASSWORD=troque_esta_senha

RABBITMQ_USER=niohub
RABBITMQ_PASSWORD=troque_esta_senha

SECRET_KEY=troque_por_uma_chave_forte_longa

DEBUG=False

OPENAI_API_KEY=

COMPOSE_PROJECT_NAME=gsfibra_painel

# Domínio já usado pelo ACS (mesmo host). Painel do app entra por outra porta.
PANEL_DOMAIN=painelapp.gsfibra.com
PANEL_PORT=8443
PANEL_PUBLIC_URL=https://painelapp.gsfibra.com:8443
LETSENCRYPT_EMAIL=contato@gsfibra.com

# TLS: internal (rápido, aviso no browser) | acme (Let's Encrypt; melhor com Cloudflare DNS)
TLS_MODE=internal

IMAGE_REGISTRY=ghcr.io/juniorssilvaa
IMAGE_TAG=latest
# Imagens: gsfibra_painel_aplicativo + gsfibra_painel_aplicativo-backend
# Front deve ser buildado com VITE_API_URL vazio (mesmo origin via Caddy).

POSTGRES_DB=gsfibra
POSTGRES_USER=gsfibra
POSTGRES_PASSWORD=
REDIS_PASSWORD=
RABBITMQ_USER=gsfibra
RABBITMQ_PASSWORD=

SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=painelapp.gsfibra.com,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://painelapp.gsfibra.com:8443
CSRF_TRUSTED_ORIGINS=https://painelapp.gsfibra.com:8443
BACKEND_URL=https://painelapp.gsfibra.com:8443
FRONTEND_URL=https://painelapp.gsfibra.com:8443
MOBILE_API_PUBLIC_BASE=https://painelapp.gsfibra.com:8443/v1

PANEL_ADMIN_USER=admin
PANEL_ADMIN_PASS=
PANEL_PROVEDOR_NOME=GSFibra

GITHUB_USER=
GITHUB_TOKEN=

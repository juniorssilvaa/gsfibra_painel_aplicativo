# Variáveis para dev local (superadmin 8010 + painel tenant 8011)

DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,api-local.niohub.com.br,admin.niohub.com.br

# Callback OAuth local — registrar na Meta (Instagram Business Login):
# https://api-local.niohub.com.br/api/auth/instagram/callback/
BACKEND_URL=https://api-local.niohub.com.br

# Webhook interno: superadmin finaliza canal no tenant local
TENANT_WEBHOOK_BASE_URL=http://127.0.0.1:8011

# Mesmo valor em painel-provedor/backend/.env
# ADMIN_WEBHOOK_SECRET=
# INSTAGRAM_APP_ID=
# INSTAGRAM_APP_SECRET=

# GSFibra Backend
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    build-essential \
    libpq-dev \
    ffmpeg \
    curl \
    postgresql-client \
    netcat-openbsd \
    cron \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .
WORKDIR /app/backend

RUN chmod +x scripts/finalize_closing_cron.py || true
RUN chmod +x scripts/billing_auto_block_cron.py || true

RUN cat << 'EOF' > /app/entrypoint.sh
#!/bin/bash
set -e

echo "Starting GSFibra Backend..."

if [ -n "$POSTGRES_HOST" ]; then
    DB_HOST="$POSTGRES_HOST"
    DB_PORT="${POSTGRES_PORT:-5432}"
elif [ -n "$DATABASE_URL" ]; then
    DB_HOST=$(echo $DATABASE_URL | sed -e 's|.*@||' -e 's|/.*||' -e 's|:.*||')
    DB_PORT=$(echo $DATABASE_URL | sed -e 's|.*:||' -e 's|/.*||')
    [[ ! "$DB_PORT" =~ ^[0-9]+$ ]] && DB_PORT=5432
else
    DB_HOST="postgres"
    DB_PORT=5432
fi

echo "Waiting for PostgreSQL at $DB_HOST:$DB_PORT..."
until nc -z -v -w3 "$DB_HOST" "$DB_PORT"; do
  sleep 1
done

python manage.py migrate --noinput
python manage.py collectstatic --noinput

echo "Launching Daphne..."
exec "$@"
EOF

RUN chmod +x /app/entrypoint.sh

RUN cat << 'EOF' > /app/cron-entrypoint.sh
#!/bin/bash
set -e

if [ -n "$POSTGRES_HOST" ]; then
    DB_HOST="$POSTGRES_HOST"
    DB_PORT="${POSTGRES_PORT:-5432}"
elif [ -n "$DATABASE_URL" ]; then
    DB_HOST=$(echo $DATABASE_URL | sed -e 's|.*@||' -e 's|/.*||' -e 's|:.*||')
    DB_PORT=$(echo $DATABASE_URL | sed -e 's|.*:||' -e 's|/.*||')
    [[ ! "$DB_PORT" =~ ^[0-9]+$ ]] && DB_PORT=5432
else
    DB_HOST="postgres"
    DB_PORT=5432
fi

until nc -z -v -w3 "$DB_HOST" "$DB_PORT"; do
  sleep 1
done

mkdir -p /var/log/gsfibra
(
  echo '*/2 * * * * cd /app/backend && python scripts/finalize_closing_cron.py >> /var/log/gsfibra/finalize_closing.log 2>&1'
  echo '*/10 * * * * cd /app/backend && python scripts/billing_auto_block_cron.py >> /var/log/gsfibra/billing_auto_block.log 2>&1'
) | crontab -

exec cron -f
EOF

RUN chmod +x /app/cron-entrypoint.sh

EXPOSE 8010

HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD curl -f -L http://localhost:8010/api/health/ || exit 1

ENTRYPOINT ["/app/entrypoint.sh"]
CMD ["daphne", "-b", "0.0.0.0", "-p", "8010", "niochat_sa.asgi:application"]
